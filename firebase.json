{
  "hosting": {
    "public": "out",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      "**/node_modules/**",
      "**/.git/**",
      "**/.env"
    ]
  },
  "functions": {
    "source": "functions"
  }
}
