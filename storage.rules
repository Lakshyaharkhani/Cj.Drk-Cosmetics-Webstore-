
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow authenticated users to upload to productImages and thumbnails folders.
    // This rule allows Rowy's service account (which acts as an authenticated entity)
    // and any logged-in user to upload images. Public read is also enabled.
    match /{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (folder == 'productImages' || folder == 'thumbnails');
    }
  }
}
