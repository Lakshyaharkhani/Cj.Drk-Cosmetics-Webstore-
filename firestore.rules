
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the authenticated user is the owner of a document
    function isOwner(userId) {
      return isUser() && request.auth.uid == userId;
    }

    // PUBLIC COLLECTIONS
    // Products are publicly readable by anyone. Writes are disallowed from the client.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    // USER-SPECIFIC COLLECTIONS
    // A user can only read and write documents within their own user folder.
    match /users/{userId} {
       allow read, write: if isOwner(userId);
    }

    // A user can only read and write their own cart
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ORDERS
    // A user can create an order for themselves.
    // They can read their own orders, but not update or delete them directly.
    match /orders/{orderId} {
      allow create: if isUser() && request.resource.data.user_id == request.auth.uid;
      allow read: if isUser() && resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
