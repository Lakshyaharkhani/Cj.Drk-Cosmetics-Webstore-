
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the authenticated user is the owner of a document
    function isOwner(userId) {
      return isUser() && request.auth.uid == userId;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isUser() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // PUBLIC COLLECTIONS
    // ==========================================
    
    // Products are publicly readable by anyone.
    // Writes are restricted to admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories are publicly readable by anyone.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // USER-SPECIFIC COLLECTIONS
    // ==========================================

    // A user can read and write their own user document.
    // An admin can read any user document.
    match /users/{userId} {
       allow get, update: if isOwner(userId);
       allow list, create, delete: if isAdmin(); // Prevent users from listing/creating others
       allow get: if isAdmin(); // Admins can read user profiles
    }

    // A user can only read and write their own cart.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ==========================================
    // ORDERS
    // ==========================================

    // A user can create an order for themselves.
    // They can read their own orders.
    // Admins can read all orders, but not update or delete them from the client.
    match /orders/{orderId} {
      allow create: if isUser() && request.resource.data.user_id == request.auth.uid;
      allow read: if isUser() && resource.data.user_id == request.auth.uid;
      allow read, list: if isAdmin();
      allow update, delete: if false; // Order updates should be handled by a backend process
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
