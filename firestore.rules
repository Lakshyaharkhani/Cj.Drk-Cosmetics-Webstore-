
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    // Checks if the request is from a logged-in user (end-user of the app)
    function isUser() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Checks if the user is the owner of a specific document
    function isOwner(userId) {
      return isUser() && request.auth.uid == userId;
    }

    // Checks if the request is from any service account (e.g., Rowy, Cloud Functions)
    // A service account is authenticated, but its 'uid' is null.
    function isServiceAccount() {
      return request.auth != null && request.auth.uid == null;
    }

    // Default match for any document in the database
    match /{document=**} {
      // Allow any service account to read or write any document.
      // This is the key rule to unblock Rowy.
      allow read, write: if isServiceAccount();
    }

    // PUBLIC COLLECTIONS
    // Products, Categories, and Policies are publicly readable by anyone.
    match /products/{productId} {
      allow read: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
    }
    match /policies/{policyId} {
      allow read: if true;
    }
    
    // USER-SPECIFIC COLLECTIONS
    // A user can only read and write documents within their own user folder.
    match /users/{userId}/{document=**} {
       allow read, write: if isOwner(userId);
    }

    // ORDERS
    // A user can only read or write an order if their UID matches the userId on the order document.
    match /orders/{orderId} {
      allow read, write: if isUser() && resource.data.userId == request.auth.uid;
    }
  }
}
