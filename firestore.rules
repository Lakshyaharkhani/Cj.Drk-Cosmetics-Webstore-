
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    // Checks if the request is from a logged-in user
    function isUser() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Checks if the user is the owner of a specific document
    function isOwner(userId) {
      return isUser() && request.auth.uid == userId;
    }

    // Checks if the request is from a service account (e.g., Rowy, Cloud Functions)
    // Service accounts are authenticated but don't have a user UID.
    function isServiceAccount() {
      return request.auth != null && request.auth.uid == null;
    }

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // PUBLIC COLLECTIONS
    // Products, Categories, and Policies are publicly readable.
    // Writes are allowed by service accounts or any authenticated user.
    match /products/{productId} {
      allow read: if true;
      allow write: if isUser() || isServiceAccount();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isUser() || isServiceAccount();
    }
    
    match /policies/{policyId} {
      allow read: if true;
      allow write: if isUser() || isServiceAccount();
    }
    
    // USER-SPECIFIC COLLECTIONS
    // A user can only read and write their own documents.
    // Service accounts can also access for administrative purposes.
    match /users/{userId}/{document=**} {
       allow read, write: if isOwner(userId) || isServiceAccount();
    }

    // ORDERS
    // Only the user who owns the order or a service account can read/write.
    match /orders/{orderId} {
      allow read, write: if (isUser() && resource.data.userId == request.auth.uid) || isServiceAccount();
    }

    // COUNTERS & INTERNAL COLLECTIONS
    // Restricted to service accounts and cloud functions only.
    match /counters/{counterId} {
      allow read, write: if isServiceAccount();
    }
  }
}
