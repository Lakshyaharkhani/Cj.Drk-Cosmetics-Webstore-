
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the authenticated user is the owner of a document
    function isOwner(userId) {
      return isUser() && request.auth.uid == userId;
    }

    // PUBLIC COLLECTIONS
    // Products, Categories, and Policies are publicly readable by anyone.
    match /products/{productId} {
      allow read: if true;
    }
    match /categories/{categoryId} {
      allow read: if true;
    }
    match /policies/{policyId} {
      allow read: if true;
    }
    
    // USER-SPECIFIC COLLECTIONS
    // A user can only read and write documents within their own user folder.
    match /users/{userId}/{document=**} {
       allow read, write: if isOwner(userId);
    }

    // ORDERS
    // A user can only read or write an order if their UID matches the userId on the order document.
    match /orders/{orderId} {
      // Allow create if the user is creating an order for themselves
      allow create: if isUser() && request.resource.data.userId == request.auth.uid;
      // Allow read, update, delete if the user is the owner of the existing order
      allow read, update, delete: if isUser() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
