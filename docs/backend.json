
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "An item available for sale in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string", "enum": ["soaps", "perfumes", "serums", "gifting"] },
        "description": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "thumbnails": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "isBestSeller": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isSale": { "type": "boolean" },
        "ingredients": { "type": "string" },
        "scentNotes": {
          "type": "object",
          "properties": {
            "top": { "type": "string" },
            "middle": { "type": "string" },
            "base": { "type": "string" }
          },
          "required": ["top", "middle", "base"]
        }
      },
      "required": ["name", "price", "category", "description", "image", "thumbnails", "rating", "reviews"]
    },
    "User": {
      "title": "User",
      "description": "A user profile for the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "points": { "type": "number" },
        "orderCount": { "type": "number" },
        "memberStatus": { "type": "string" },
        "avatar": { "type": "string", "format": "uri" }
      },
      "required": ["name", "email", "points", "orderCount", "memberStatus", "avatar"]
    },
    "Cart": {
      "title": "Cart",
      "description": "A user's shopping cart.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/entities/CartItem" }
        },
        "updated_at": { "type": "number" }
      },
      "required": ["user_id", "items", "updated_at"]
    },
    "CartItem": {
      "title": "Cart Item",
      "description": "An item within a shopping cart.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "quantity": { "type": "number" }
      },
      "required": ["product_id", "quantity"]
    },
    "Order": {
        "title": "Order",
        "description": "A customer order.",
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "user_id": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "object" }
          },
          "grand_total": { "type": "number" },
          "status": { "type": "string" },
          "created_at": { "type": "number" }
        },
        "required": ["id", "user_id", "items", "grand_total", "status", "created_at"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores all product details."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Stores customer orders."
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Stores persistent user shopping carts."
    }
  }
}
